// ============================================================================
// PET SOCIAL NETWORK — PRISMA ORM SCHEMA
// Database Engine: PostgreSQL 16.x
// Architecture: Clean Architecture / Modular Domain Design
// ============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  BANNED

  @@map("user_status")
}

enum PetSpecies {
  DOG
  CAT
  OTHER

  @@map("pet_species")
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN

  @@map("pet_gender")
}

enum MediaType {
  NONE
  IMAGE
  VIDEO

  @@map("media_type")
}

enum PostStatus {
  PUBLIC
  HIDDEN
  SOFT_DELETED

  @@map("post_status")
}

enum ReportReason {
  CRUELTY
  SPAM
  OFFENSIVE
  FRAUD
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED

  @@map("report_status")
}

// ============================================================================
// 2. CORE DOMAIN MODELS
// ============================================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  bio          String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  // Relationships
  pets        Pet[]
  posts       Post[]
  paws        Paw[]
  comments    Comment[]
  reports     Report[]   @relation("UserReports")
  
  // Follows: User A follows User B
  following   Follow[]   @relation("UserFollowing")
  followers   Follow[]   @relation("UserFollowers")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Pet {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatarUrl String?    @map("avatar_url")
  species   PetSpecies
  breed     String     // e.g. "Corgi", "Mèo Mướp", "Poodle", "Golden"
  birthDate DateTime?  @map("birth_date")
  gender    PetGender  @default(UNKNOWN)
  bio       String?

  // Many-to-many relationship with posts via PostPetTag
  postTags  PostPetTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([species, breed])
  @@map("pets")
}

model Post {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String     @db.Text
  mediaType    MediaType  @default(NONE) @map("media_type")
  mediaUrls    String[]   @map("media_urls") // Array of image/video URLs
  status       PostStatus @default(PUBLIC)
  pawCount     Int        @default(0) @map("paw_count")
  commentCount Int        @default(0) @map("comment_count")

  // Relationships
  petTags   PostPetTag[]
  paws      Paw[]
  comments  Comment[]
  reports   Report[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status, createdAt(sort: Desc)])
  @@map("posts")
}

model PostPetTag {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  petId     String   @map("pet_id")
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, petId])
  @@index([petId])
  @@map("post_pet_tags")
}

model Paw {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // Guarantee: One Paw per User per Post
  @@unique([userId, postId])
  @@index([postId])
  @@map("paws")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // 1-Level Nesting: parentId is null for root comments; points to root comment for replies
  parentId  String?  @map("parent_id")
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  content   String   @db.Text
  isDeleted Boolean  @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postId, createdAt(sort: Asc)])
  @@index([parentId])
  @@map("comments")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @map("following_id")
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  // Guarantee: One active follow per pair
  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String       @map("reporter_id")
  reporter   User         @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String       @map("post_id")
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)

  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([reporterId, postId])
  @@index([status])
  @@map("reports")
}
