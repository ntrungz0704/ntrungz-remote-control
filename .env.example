# ==============================================================================
# FAST-SHIP-HUB — MẪU BIẾN MÔI TRƯỜNG MẪU (.ENV.EXAMPLE)
# ==============================================================================

# Core System
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://fastshiphub.vn
NEXTAUTH_URL=https://fastshiphub.vn
NEXTAUTH_SECRET=fsh_super_secret_jwt_key_2026_production_min32chars

# Database & Cache
DATABASE_URL=postgresql://fastship:FastShip2026Secure!@localhost:5432/fast_ship_hub?schema=public
REDIS_URL=redis://localhost:6379

# VietQR Napas 24/7 Gateway
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=CONG TY CO PHAN FAST SHIP HUB
VIETQR_TEMPLATE=compact

# Carrier API Credentials & Webhook HMAC Secrets
# 1. GrabExpress
GRAB_CLIENT_ID=grab_client_id_placeholder
GRAB_CLIENT_SECRET=grab_client_secret_placeholder
GRAB_WEBHOOK_SECRET=grab_webhook_secret_key_production_2026

# 2. ShopeeFood Delivery
SHOPEEFOOD_PARTNER_ID=shopeefood_partner_id_placeholder
SHOPEEFOOD_PARTNER_KEY=shopeefood_partner_key_placeholder
SHOPEEFOOD_WEBHOOK_SECRET=shopeefood_webhook_secret_key_production_2026

# 3. Xanh SM (GSM EV Delivery)
XANH_SM_API_KEY=xanhsm_api_key_placeholder
XANH_SM_MERCHANT_ID=xanhsm_merchant_id_placeholder
XANH_SM_WEBHOOK_SECRET=xanhsm_webhook_secret_key_production_2026

# 4. Ahamove
AHAMOVE_API_KEY=ahamove_api_key_placeholder
AHAMOVE_PHONE_NUMBER=0987654321
AHAMOVE_WEBHOOK_SECRET=ahamove_webhook_secret_key_production_2026

# 5. BeDelivery (Be Group)
BE_CLIENT_ID=be_client_id_placeholder
BE_CLIENT_SECRET=be_client_secret_placeholder
BE_WEBHOOK_SECRET=be_webhook_secret_key_production_2026

# 6. Sandbox Mock Carrier
MOCK_SANDBOX_ENABLED=true
MOCK_SANDBOX_WEBHOOK_SECRET=mock_webhook_secret_key_sandbox_2026
